function buildV3Data(cloudRecords, cloudIndex) {
  const metadata = {
    lastSyncAt: new Date().toISOString(),
    cloudVersion: cloudIndex?.version || 'v1',
    availableDates: cloudIndex?.records?.map(r => r.date) || []
  };
  const currentData = parseRecord(cloudRecords[0]);
  const allCitiesData = currentData.all?.cities || [];
  let totalData = null;
  const citiesData = [];
  allCitiesData.forEach(city => {
    if (city.name === '总商') { totalData = city; } else { citiesData.push(city); }
  });
  const formattedCurrentData = {
    totals: totalData && totalData.modules && totalData.modules.all ? totalData.modules.all : {},
    cities: citiesData
  };
  const cache = {};
  cloudRecords.slice(0, 3).forEach(record => { cache[record.date] = parseRecord(record); });
  const importHistory = cloudRecords.map(record => ({ monthLabel: record.date, data: null, importedAt: record.updatedAt || record.date, fileName: record.fileName || '' }));
  return { version: 3, metadata, currentData: formattedCurrentData, cache, importHistory, currentImportIndex: 0, currentMerchantType: 'all' };
}}
    
    /**
     * 初始化应用状态
     * @param {Object} data - v3 格式的数据
     */
    function initializeAppState(data) {
      // 从 window.financeToolCache（内存）或 data.cache 获取 allMerchantData
      const currentRecord = data.importHistory[data.currentImportIndex];
      let localAllMerchantData = window.financeToolCache?.[currentRecord.monthLabel] || data.cache?.[currentRecord.monthLabel];
      
      // 如果 cache 中没有，从 importHistory 读取（兼容旧数据）
      if (!localAllMerchantData && currentRecord.data) {
        localAllMerchantData = currentRecord.data;
      }
      
      // 如果还是没有，使用当前数据反向构建
      if (!localAllMerchantData) {
        console.warn('[App] 无法从 cache 或 importHistory 获取数据，使用当前数据');
        localAllMerchantData = {
          all: {
            cities: [
              { name: '总商', displayName: '总商', modules: { all: data.currentData.totals } },
              ...data.currentData.cities.map(c => ({ name: c.displayName, displayName: c.displayName, modules: { all: c.modules?.all || {} } }))
            ]
          }
        };
      }
      
      // 更新全局变量和局部变量（使用不同的变量名避免混淆）
      window.allMerchantData = localAllMerchantData;
      window.importHistory = data.importHistory;
      window.currentData = data.currentData;
      window.currentImportIndex = data.currentImportIndex;
      window.currentMerchantType = data.currentMerchantType;
      // 不覆盖已有的内存缓存（window.financeToolCache 在云端加载时已设置）
      if (!window.financeToolCache || Object.keys(window.financeToolCache).length === 0) {
        window.financeToolCache = data.cache || {};
      }
      
      // 同时更新外部定义的变量（供内部函数使用）
      allMerchantData = localAllMerchantData;
      importHistory = data.importHistory;
      currentData = data.currentData;
      currentImportIndex = data.currentImportIndex;
      currentMerchantType = data.currentMerchantType;
      
      console.log('[App] 全局变量和局部变量已设置，allMerchantData:', !!allMerchantData);
      
      // 初始化状态管理器
      StateManager.init({
        currentData: data.currentData,
        allMerchantData: localAllMerchantData,
        importHistory: data.importHistory,
        currentImportIndex: data.currentImportIndex,
        currentMerchantType: data.currentMerchantType
      });
      
      // 订阅 StateManager 状态变更，自动同步全局变量
      StateManager.subscribe('*', (key, newValue, oldValue) => {
        console.log('[StateManager] 状态变更订阅触发:', key);
        if (key === 'allMerchantData' || key === '*') {
          window.allMerchantData = newValue;
          console.log('[StateManager] 已同步全局 allMerchantData');
        }
        if (key === 'currentData' || key === '*') {
          window.currentData = newValue;
        }
      });
      
      console.log('[App] StateManager 初始化完成，allMerchantData:', !!StateManager.get('allMerchantData'));
      
      // 渲染 UI（确保 allMerchantData 已设置）
      // 趋势分析延迟到切换tab时再渲染，避免初始化时生成大量HTML
      renderImportSelector();
      renderOverview();
      renderDimension();
      
      console.log('[App] 应用状态初始化完成', {
        hasData: !!allMerchantData,
        historyCount: data.importHistory.length,
        cacheSize: Object.keys(data.cache || {}).length
      });
    }

    async function loadFromCloud() {
  console.log('[App] 开始加载云端数据 (V3模式)');
  const localData = DataStore.load();
  if (!localData || !localData.metadata || localData.version !== 3) {
    try {
      const indexResponse = await fetch('./index.json');
      const cloudIndex = await indexResponse.json();
      const dataResponse = await fetch('./shared-data.json');
      const cloudRecords = await dataResponse.json();
      const v3Data = buildV3Data(cloudRecords, cloudIndex);
      DataStore.save(v3Data);
      return v3Data;
    } catch (e) { console.error('[App] 加载云端数据失败:', e); throw e; }
  }
  const hasUpdate = await checkCloudForUpdates(localData);
  if (hasUpdate) {
    try {
      const indexResponse = await fetch('./index.json');
      const cloudIndex = await indexResponse.json();
      const dataResponse = await fetch('./shared-data.json');
      const cloudRecords = await dataResponse.json();
      const v3Data = buildV3Data(cloudRecords, cloudIndex);
      DataStore.save(v3Data);
      return v3Data;
    } catch (e) { console.error('[App] 获取更新数据失败:', e); }
  }
  return localData;
}}\n\nasync function checkCloudForUpdates(localData) {
      try {
        const indexResponse = await fetch('./index.json');
        if (!indexResponse.ok) return false;
        const cloudIndex = await indexResponse.json();
        const localVersion = localData.metadata?.cloudVersion || '0';
        const cloudVersion = cloudIndex.version || '0';
        if (parseInt(cloudVersion) > parseInt(localVersion)) return true;
        const localDates = new Set(localData.metadata?.availableDates || []);
        const cloudDates = new Set(cloudIndex.records?.map(r => r.date) || []);
        const newDates = [...cloudDates].filter(d => !localDates.has(d));
        if (newDates.length > 0) return true;
        return false;
      } catch (e) {
        console.error('[App] 检查更新失败:', e);
        return false;
      }
    }\n\n
    
    /**
     * 检查云端是否有新数据
     * @param {Object} localData - 本地数据
     * @returns {Promise<boolean>} - 是否有新数据
     */
    function checkCloudForUpdates(localData) {
      try {
        console.log('[App] 检查云端更新...');
        
        let cloudData = null;
        
        // 优先使用直接下载的方式（更稳定，不受 GitHub API 限流影响）
        const directUrl = 'https://raw.githubusercontent.com/xinglianyue/finance-tool/main/shared-data.json';
        try {
          const directResponse = await fetch(directUrl);
          if (directResponse.ok) {
            cloudData = await directResponse.json();
            console.log('[App] 从直接下载获取云端数据成功');
          }
        } catch (directError) {
          console.warn('[App] 直接下载失败，尝试 GitHub API');
        }
        
        // 如果直接下载失败，尝试用 GitHub API
        if (!cloudData) {
          const apiUrl = 'https://api.github.com/repos/xinglianyue/finance-tool/contents/shared-data.json';
          const response = await fetch(apiUrl, { signal: AbortSignal.timeout(10000) });
          
          if (!response.ok) {
            console.log('[App] 无法连接云端');
            return false;
          }
          
          const githubData = await response.json();
          
          if (githubData.content && githubData.content.trim() !== '') {
            try {
              const base64Content = githubData.content.replace(/\n/g, '');
              const decodedContent = decodeURIComponent(escape(atob(base64Content)));
              cloudData = JSON.parse(decodedContent);
              console.log('[App] 从API content解析云端数据成功');
            } catch (parseError) {
              console.log('[App] 尝试download_url...');
            }
          }
          
          if (!cloudData && githubData.download_url) {
            const downloadResponse = await fetch(githubData.download_url);
            if (downloadResponse.ok) {
              cloudData = await downloadResponse.json();
              console.log('[App] 从download_url下载云端数据成功');
            }
          }
        }
        
        if (!cloudData || !Array.isArray(cloudData) || cloudData.length === 0) {
          console.log('[App] 云端数据为空');
          return false;
        }
        
        // 对比本地和云端的日期列表
        const localDates = (localData.importHistory || []).map(r => r.monthLabel);
        const cloudDates = cloudData.map(r => normalizeDateLabel(r.date));
        const cloudRecordsNormalized = cloudData.map(r => ({
          ...r,
          normalizedDate: normalizeDateLabel(r.date)
        }));
        
        console.log('[App] 本地日期:', localDates);
        console.log('[App] 云端日期 (原始):', cloudData.map(r => r.date));
        console.log('[App] 云端日期 (标准化):', cloudDates);
        
        // 检查是否有新的日期
        const newDates = cloudDates.filter(d => !localDates.includes(d));
        if (newDates.length > 0) {
          console.log('[App] 发现新日期:', newDates);
          return true;
        }
        
        // 检查相同日期的更新时间是否变化
        for (const localRecord of localData.importHistory || []) {
          const cloudRecord = cloudRecordsNormalized.find(c => c.normalizedDate === localRecord.monthLabel);
          if (cloudRecord && cloudRecord.updatedAt && localRecord.importedAt) {
            const cloudTime = new Date(cloudRecord.updatedAt);
            const localTime = new Date(localRecord.importedAt);
            if (cloudTime > localTime) {
              console.log('[App] 发现已有记录更新:', localRecord.monthLabel);
              return true;
            }
          }
        }
        
        console.log('[App] 云端数据未更新');
        return false;
        
      } catch (e) {
        console.error('[App] 检查更新失败:', e);
        return false;
      }
    }

    // 性能优化：防抖保存，避免切换数据时同步阻塞UI
    let _saveTimer = null;
    function saveToLocalStorage() {
      if (_saveTimer) clearTimeout(_saveTimer);
      _saveTimer = setTimeout(() => {
        _saveTimer = null;
        const data = StateManager.getDataToSave();
        const success = DataStore.save(data);
        if (!success) {
          console.error('数据保存失败');
          showToast('数据保存失败，请检查存储空间', 'error');
        }
      }, 300);
    }

    function loadFromLocalStorage() {
      try {
        const data = DataStore.load();
        if (data) {
          // 验证数据完整性
          const validation = DataStore.validate(data);
          if (!validation.valid) {
            console.error('数据验证失败:', validation.errors);
            showToast('数据可能已损坏，尝试从备份恢复...', 'warning');
            const restored = DataStore.restoreFromBackup();
            if (restored) {
              data = restored;
              showToast('已从备份恢复数据', 'success');
            } else {
              showToast('数据恢复失败，请重新导入', 'error');
              return false;
            }
          }
          
          // 显示警告
          if (validation.warnings?.length > 0) {
            console.warn('数据警告:', validation.warnings);
          }
          
          // 初始化状态管理器
          StateManager.init(data);
          
          // 同步全局变量（兼容性）
          currentData = StateManager.get('currentData');
          allMerchantData = StateManager.get('allMerchantData');
          importHistory = StateManager.get('importHistory');
          currentImportIndex = StateManager.get('currentImportIndex');
          currentMerchantType = StateManager.get('currentMerchantType');
          
          // 恢复缓存到全局变量（供趋势分析使用）
      if (data.cache) {
        window.financeToolCache = data.cache;
      }
      
      // 如果缓存为空但导入历史有数据，尝试从其他来源重建缓存
      if (!window.financeToolCache || Object.keys(window.financeToolCache).length === 0 && importHistory.length > 0) {
        console.log('[App] 缓存为空，尝试从其他来源重建...');
        
        // 1. 尝试从已有的所有merchantData构建缓存（针对当前选中的日期）
        if (allMerchantData) {
          const currentRecord = importHistory[currentImportIndex];
          if (currentRecord) {
            window.financeToolCache = window.financeToolCache || {};
            window.financeToolCache[currentRecord.monthLabel] = allMerchantData;
            console.log('[App] 从 allMerchantData 重建缓存，日期:', currentRecord.monthLabel);
          }
        }
        
        // 2. 如果仍然为空，尝试从云端数据中获取（如果有cloudData全局变量）
        if (!window.financeToolCache || Object.keys(window.financeToolCache).length === 0 && window.cloudData) {
          importHistory.forEach(record => {
            const cloudRecord = window.cloudData.find(r => r.date === record.monthLabel);
            if (cloudRecord) {
              const merchantData = cloudRecord.merchantData || cloudRecord.currentData?.merchantData;
              if (merchantData) {
                // 兼容旧格式
                if (!merchantData.all && merchantData.cities) {
                  merchantData.all = { date: record.monthLabel, cities: merchantData.cities };
                }
                window.financeToolCache = window.financeToolCache || {};
                window.financeToolCache[record.monthLabel] = merchantData;
              }
            }
          });
          if (Object.keys(window.financeToolCache).length > 0) {
            console.log('[App] 从 cloudData 重建缓存，共 ' + Object.keys(window.financeToolCache).length + ' 个日期');
          }
        }
      }
      
      // 恢复导入日期选择器
      if (importHistory.length > 0) {
        renderImportSelector();
      }
          
          return true;
        }
      } catch (e) {
        console.error('加载失败:', e);
        showToast('数据加载失败: ' + e.message, 'error');
      }
      return false;
    }

    function num(v) {
      if (v === null || v === undefined || v === '' || v === '-') return 0;
      const n = parseFloat(String(v).replace(/,/g, ''));
      return isNaN(n) ? 0 : n;
    }

    function function extractModuleFromBlock(data, startRowIndex, colIndex, fieldLookup) {
      const result = {};
      fieldLookup.forEach(fd => result[fd.name] = 0);
      const scanStart = startRowIndex + 3;
      const scanEnd = Math.min(startRowIndex + 120, data.length);
      
      for (let rn = scanStart; rn < scanEnd; rn++) {
        const row = data[rn];
        if (!row) continue;
        const c3 = String(row[3] || '').trim();
        if (c3 && c3.includes('财务指标')) break;
        const val = colIndex < row.length ? row[colIndex] : 0;
        const numVal = Number(val);
        if (isNaN(numVal) || numVal <= 0) continue;
        const row0 = String(row[0] || '').toLowerCase();
        for (const fd of fieldLookup) {
          if (fd.keys && fd.keys.some(k => row0.includes(k.toLowerCase()))) {
            if (result[fd.name] === 0) result[fd.name] = numVal;
          }
        }
      }
      const nonZeroCount = Object.values(result).filter(v => v > 0).length;
      return nonZeroCount >= 3 ? result : null;
    }}\n\nfunction parseExcelData(workbook, fileName) {
      console.log('[parseExcelData] 开始解析 Excel 文件:', fileName);

      try {
        const MODULE_DEFS = [
          { searchName: '全品类财务指标', key: 'all', label: '全品类' },
          { searchName: '餐饮财务指标', key: 'food', label: '餐饮' },
          { searchName: '闪购财务指标', key: 'flash', label: '闪购' },
          { searchName: '医药财务指标', key: 'medicine', label: '医药' },
          { searchName: '拼好饭财务指标', key: 'group', label: '拼好饭' }
        ];

        const FIELD_LOOKUP = [
          { keys: ['orders', '订单量'], name: 'orders' },
          { keys: ['gmvAmount', '原价交易额'], name: 'gmvAmount' },
          { keys: ['onlineRevenue', '线上收入'], name: 'onlineRevenue' },
          { keys: ['profit', '毛利'], name: 'profit' },
          { keys: ['commission', '抽佣金额'], name: 'commission' },
          { keys: ['deliveryFee', '配送费'], name: 'deliveryFee' },
          { keys: ['subsidyTotal', '代补金额'], name: 'subsidyTotal' },
          { keys: ['platformCost', '平台成本'], name: 'platformCost' },
          { keys: ['deliveryCost', '配送成本'], name: 'deliveryCost' },
          { keys: ['fixedCost', '固定成本'], name: 'fixedCost' },
          { keys: ['additionalCost', '附加成本'], name: 'additionalCost' },
          { keys: ['totalExpense', '支出汇总'], name: 'totalExpense' }
        ];

        const dataSheet = workbook.Sheets[workbook.SheetNames[0]];
        if (!dataSheet) throw new Error('未找到工作表');

        const jsonData = XLSX.utils.sheet_to_json(dataSheet, { header: 1 });
        
        // 动态搜索模块位置
        const modulePositions = {};
        for (let rn = 0; rn < Math.min(500, jsonData.length); rn++) {
          const row = jsonData[rn];
          if (!row || !row[0]) continue;
          const cell0 = String(row[0] || '').trim();
          for (const md of MODULE_DEFS) {
            if (cell0.includes(md.searchName)) {
              modulePositions[md.key] = rn;
            }
          }
        }

        console.log('[parseExcelData] 找到的模块:', Object.keys(modulePositions));
        if (Object.keys(modulePositions).length === 0) {
          throw new Error('未识别到任何财务指标模块');
        }

        const cityRow = jsonData[2];
        if (!cityRow) throw new Error('未找到城市信息行');

        const result = {
          totals: { orders: 0, gmvAmount: 0, onlineRevenue: 0, profit: 0, ue: 0, profitRate: 0 },
          cities: []
        };

        for (let col = 5; col < cityRow.length; col++) {
          const excelName = String(cityRow[col] || '').trim();
          if (!excelName || excelName === '总商') continue;

          const cityData = { name: excelName, modules: {} };

          for (const md of MODULE_DEFS) {
            if (!modulePositions[md.key]) continue;

            const moduleStartRow = modulePositions[md.key];
            const moduleFields = extractModuleFromBlock(jsonData, moduleStartRow, col, FIELD_LOOKUP);

            if (moduleFields && Object.keys(moduleFields).length > 0) {
              cityData.modules[md.key] = { ...moduleFields, moduleName: md.label, moduleKey: md.key };
              const m = cityData.modules[md.key];
              m.ue = m.orders > 0 ? m.profit / m.orders : 0;
              m.subsidyRatio = m.gmvAmount > 0 ? (m.subsidyTotal || 0) / m.gmvAmount : 0;
              m.profitRate = m.onlineRevenue > 0 ? m.profit / m.onlineRevenue : 0;
            }
          }

          result.cities.push(cityData);
        }

        if (result.cities.length > 0) {
          for (const modKey in result.cities[0].modules) {
            result.cities.forEach(c => {
              if (c.modules[modKey]) {
                const m = c.modules[modKey];
                result.totals.orders += m.orders || 0;
                result.totals.gmvAmount += m.gmvAmount || 0;
                result.totals.onlineRevenue += m.onlineRevenue || 0;
                result.totals.profit += m.profit || 0;
              }
            });
          }
          result.totals.ue = result.totals.orders > 0 ? result.totals.profit / result.totals.orders : 0;
          result.totals.profitRate = result.totals.onlineRevenue > 0 ? result.totals.profit / result.totals.onlineRevenue : 0;
        }

        console.log('[parseExcelData] 解析完成！城市数:', result.cities.length);
        return result;

      } catch (error) {
        console.error('[parseExcelData] 解析失败:', error);
        throw error;
      }
    }}

    /**
     * @description 显示KPI骨架屏，数据加载时展示
     */
    function showSkeleton() {
      const kpiCards = document.getElementById('kpiCards');
      if (!kpiCards) return;
      let html = '';
      for (let i = 0; i < 7; i++) {
        html += '<div class="skeleton-card"><div class="skeleton skeleton-line short"></div><div class="skeleton skeleton-value"></div></div>';
      }
      kpiCards.innerHTML = html;
    }

    /**
     * @description 切换KPI详情面板的显示/隐藏
     * @param {number} index - KPI卡片索引
     */
    function toggleKpiDetail(index) {
      const panel = document.getElementById('kpiDetailPanel');
      const grid = document.getElementById('kpiCards');
      if (panel && panel.dataset.index === String(index)) {
        panel.remove();
        return;
      }
      if (panel) panel.remove();

      const totals = currentData?.totals;
      if (!totals) return;

      const kpiDetails = [
        { label: '原价交易额', value: formatMoney(totals.gmvAmount), rows: [
          { label: '加盟GMV', value: formatMoney(totals.franchiseGMV) },
          { label: '自营GMV', value: formatMoney(totals.selfGMV) }
        ]},
        { label: '订单量', value: formatNumber(totals.orders), rows: [
          { label: '加盟订单', value: formatNumber(totals.franchiseOrders) },
          { label: '自营订单', value: formatNumber(totals.selfOrders) }
        ]},
        { label: '单均收入', value: (parseFloat(totals.avgRevenuePerOrder) || 0).toFixed(2), rows: [] },
        { label: '单均支出', value: (parseFloat(totals.avgCostPerOrder) || 0).toFixed(2), rows: [] },
        { label: '单均UE', value: (parseFloat(totals.ue) || 0).toFixed(2), rows: [
          { label: '健康状态', value: parseFloat(totals.ue) >= 0.5 ? '✅ 健康' : parseFloat(totals.ue) >= 0.1 ? '⚠️ 预警' : '🚨 危险' },
          { label: 'UE进度', value: Math.min(parseFloat(totals.ue) / 1.0 * 100, 100).toFixed(0) + '%' }
        ]},
        { label: '毛利率', value: formatPercent(totals.profitRate), rows: [
          { label: '健康状态', value: parseFloat(totals.profitRate) >= 0.2 ? '✅ 健康' : parseFloat(totals.profitRate) >= 0.1 ? '⚠️ 预警' : '🚨 危险' },
          { label: '利率进度', value: Math.min(parseFloat(totals.profitRate) / 0.3 * 100, 100).toFixed(0) + '%' }
        ]},
        { label: '毛利总额', value: formatMoney(totals.profit), rows: [] }
      ];

      const detail = kpiDetails[index];
      if (!detail) return;

      let html = '<div class="kpi-detail-panel" id="kpiDetailPanel" data-index="' + index + '">';
      html += '<div class="kpi-detail-title"><span>' + detail.label + '</span><span class="kpi-detail-close" onclick="closeKpiDetail()">✕</span></div>';
      html += '<div class="kpi-detail-row"><span class="kpi-detail-row-label">当前值</span><span class="kpi-detail-row-value">' + detail.value + '</span></div>';
      detail.rows.forEach(row => {
        html += '<div class="kpi-detail-row"><span class="kpi-detail-row-label">' + row.label + '</span><span class="kpi-detail-row-value">' + row.value + '</span></div>';
      });
      // UE进度条
      if (index === 4) {
        const uePct = Math.min(Math.max(parseFloat(totals.ue) / 1.0 * 100, 0), 100);
        const ueColor = parseFloat(totals.ue) >= 0.5 ? 'var(--success)' : parseFloat(totals.ue) >= 0.1 ? 'var(--warning)' : 'var(--danger)';
        html += '<div style="margin-top:8px;height:6px;border-radius:3px;background:var(--neutral-bg);overflow:hidden;"><div style="height:100%;width:' + uePct + '%;border-radius:3px;background:' + ueColor + ';transition:width .6s var(--ease);"></div></div>';
      }
      // 毛利率进度条
      if (index === 5) {
        const prPct = Math.min(Math.max(parseFloat(totals.profitRate) / 0.3 * 100, 0), 100);
        const prColor = parseFloat(totals.profitRate) >= 0.2 ? 'var(--success)' : parseFloat(totals.profitRate) >= 0.1 ? 'var(--warning)' : 'var(--danger)';
        html += '<div style="margin-top:8px;height:6px;border-radius:3px;background:var(--neutral-bg);overflow:hidden;"><div style="height:100%;width:' + prPct + '%;border-radius:3px;background:' + prColor + ';transition:width .6s var(--ease);"></div></div>';
      }
      html += '</div>';

      // 插入到点击的KPI卡片后面
      const cards = grid.querySelectorAll('.kpi-compact');
      if (cards[index]) {
        cards[index].insertAdjacentHTML('afterend', html);
      }
    }

    /**
     * @description 关闭KPI详情面板
     */
    function closeKpiDetail() {
      const panel = document.getElementById('kpiDetailPanel');
      if (panel) panel.remove();
    }

    const _renderOverview = function renderOverview() {
      if (!currentData) return;

      document.getElementById('overviewEmpty').classList.add('hidden');
      document.getElementById('overviewData').classList.remove('hidden');

      const totals = currentData.totals;

      const ueLevel = parseFloat(totals.ue) >= 0.5 ? 'success' : parseFloat(totals.ue) >= 0.1 ? 'warning' : 'danger';
      const profitRateLevel = parseFloat(totals.profitRate) >= 0.2 ? 'success' : parseFloat(totals.profitRate) >= 0.1 ? 'warning' : 'danger';

      // UE进度条
      const ueVal = parseFloat(totals.ue) || 0;
      const uePct = Math.min(Math.max(ueVal / 1.0 * 100, 0), 100);
      const ueBarColor = ueVal >= 0.5 ? 'var(--success)' : ueVal >= 0.1 ? 'var(--warning)' : 'var(--danger)';

      // 毛利率进度条
      const prVal = parseFloat(totals.profitRate) || 0;
      const prPct = Math.min(Math.max(prVal / 0.3 * 100, 0), 100);
      const prBarColor = prVal >= 0.2 ? 'var(--success)' : prVal >= 0.1 ? 'var(--warning)' : 'var(--danger)';

      const dotSuccess = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:var(--success);"></span>';
      const dotWarning = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:var(--warning);"></span>';
      const dotDanger = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:var(--danger);"></span>';
      const dotPrimary = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:var(--primary);"></span>';

      const isMobileView = window.innerWidth <= 576;

      if (isMobileView) {
        // 移动端紧凑网格
        const kpis = [
          { label: '交易额', value: formatMoney(totals.gmvAmount), badge: '', cls: '' },
          { label: '订单量', value: formatNumber(totals.orders), badge: '', cls: '' },
          { label: '单均收入', value: (parseFloat(totals.avgRevenuePerOrder) || 0).toFixed(2), badge: '', cls: '' },
          { label: '单均支出', value: (parseFloat(totals.avgCostPerOrder) || 0).toFixed(2), badge: '', cls: '' },
          { label: 'UE', value: (parseFloat(totals.ue) || 0).toFixed(2), badge: ueLevel === 'success' ? '✅' : ueLevel === 'warning' ? '⚠️' : '🚨', cls: ueLevel },
          { label: '毛利率', value: formatPercent(totals.profitRate), badge: profitRateLevel === 'success' ? '✅' : profitRateLevel === 'warning' ? '⚠️' : '🚨', cls: profitRateLevel },
          { label: '毛利', value: formatMoney(totals.profit), badge: '', cls: '' }
        ];
        let mobileHtml = '';
        kpis.forEach((kpi, i) => {
          mobileHtml += '<div class="kpi-compact' + (kpi.cls ? ' highlight ' + kpi.cls : '') + '" onclick="toggleKpiDetail(' + i + ')">';
          mobileHtml += '<span class="kpi-compact-label">' + kpi.label + '</span>';
          mobileHtml += '<span class="kpi-compact-value">' + kpi.value + '</span>';
          if (kpi.badge) {
            const badgeCls = kpi.cls === 'success' ? 'up' : kpi.cls === 'warning' ? 'warn' : 'down';
            mobileHtml += '<span class="kpi-compact-badge ' + badgeCls + '">' + kpi.badge + '</span>';
          }
          mobileHtml += '</div>';
        });
        document.getElementById('kpiCards').innerHTML = mobileHtml;
        document.getElementById('kpiCards').classList.add('compact');
      } else {
        // 桌面端原有KPI渲染
        document.getElementById('kpiCards').classList.remove('compact');
        document.getElementById('kpiCards').innerHTML = `
        <div class="kpi-card">
          <div class="accent"></div>
          <div class="kpi-label">${dotPrimary}原价交易额</div>
          <div class="kpi-value">${formatMoney(totals.gmvAmount)}</div>
        </div>
        <div class="kpi-card">
          <div class="accent"></div>
          <div class="kpi-label">${dotPrimary}订单量</div>
          <div class="kpi-value">${formatNumber(totals.orders)}</div>
        </div>
        <div class="kpi-card">
          <div class="accent"></div>
          <div class="kpi-label">${dotPrimary}单均收入</div>
          <div class="kpi-value">${(parseFloat(totals.avgRevenuePerOrder) || 0).toFixed(2)}</div>
        </div>
        <div class="kpi-card">
          <div class="accent"></div>
          <div class="kpi-label">${dotPrimary}单均支出</div>
          <div class="kpi-value">${(parseFloat(totals.avgCostPerOrder) || 0).toFixed(2)}</div>
        </div>
        <div class="kpi-card ${ueLevel}">
          <div class="accent"></div>
          <div class="kpi-label">${ueLevel === 'success' ? dotSuccess : ueLevel === 'warning' ? dotWarning : dotDanger}单均UE</div>
          <div class="kpi-value">${(parseFloat(totals.ue) || 0).toFixed(2)}</div>
          <div class="kpi-change ${parseFloat(totals.ue) >= 0.5 ? 'up' : 'down'}">
            ${parseFloat(totals.ue) >= 0.5 ? '✅ 健康' : parseFloat(totals.ue) >= 0.1 ? '⚠️ 预警' : '🚨 危险'}
          </div>
          <div style="margin-top:6px;height:4px;border-radius:2px;background:var(--neutral-bg);overflow:hidden;"><div style="height:100%;width:${uePct}%;border-radius:2px;background:${ueBarColor};transition:width .6s var(--ease);"></div></div>
        </div>
        <div class="kpi-card ${profitRateLevel}">
          <div class="accent"></div>
          <div class="kpi-label">${profitRateLevel === 'success' ? dotSuccess : profitRateLevel === 'warning' ? dotWarning : dotDanger}毛利率</div>
          <div class="kpi-value">${formatPercent(totals.profitRate)}</div>
          <div class="kpi-change ${parseFloat(totals.profitRate) >= 0.2 ? 'up' : 'down'}">
            ${parseFloat(totals.profitRate) >= 0.2 ? '✅ 健康' : parseFloat(totals.profitRate) >= 0.1 ? '⚠️ 预警' : '🚨 危险'}
          </div>
          <div style="margin-top:6px;height:4px;border-radius:2px;background:var(--neutral-bg);overflow:hidden;"><div style="height:100%;width:${prPct}%;border-radius:2px;background:${prBarColor};transition:width .6s var(--ease);"></div></div>
        </div>
        <div class="kpi-card success">
          <div class="accent"></div>
          <div class="kpi-label">${dotSuccess}毛利总额</div>
          <div class="kpi-value">${formatMoney(totals.profit)}</div>
        </div>
        `;
      }

      renderCityRankTable();
    }

    function updateHealthScore() {
      if (!currentData) return;

      let good = 0, warning = 0, danger = 0;

      currentData.cities.forEach(city => {
        const mod = city.modules.all || {};
        const ue = parseFloat(mod.ue) || 0;
        const profitRate = parseFloat(mod.profitRate) || 0;

        if (ue >= 0.5 && profitRate >= 0.2) good++;
        else if (ue >= 0.1 && profitRate >= 0.1) warning++;
        else danger++;
      });

      document.getElementById('healthGood').textContent = good;
      document.getElementById('healthWarning').textContent = warning;
      document.getElementById('healthDanger').textContent = danger;

      const total = currentData.cities.length || 1;
      const score = Math.round(((good * 100) + (warning * 50)) / total);
      document.getElementById('healthScore').textContent = score;

      const circumference = 2 * Math.PI * 70;
      const offset = circumference - (score / 100) * circumference;
      document.getElementById('healthRing').setAttribute('stroke-dashoffset', offset);
    }

    function renderAnomalyList() {
      const anomalyList = document.getElementById('anomalyList');
      let html = '';

      currentData.cities.forEach(city => {
        const mod = city.modules.all || {};
        const ue = parseFloat(mod.ue) || 0;
        const profitRate = parseFloat(mod.profitRate) || 0;

        if (ue < 0.1) {
          html += `<div class="collapsible"><div class="collapsible-header">🚨 ${getCityDisplayName(city.displayName)} - UE危险 <span class="text-danger">${ue.toFixed(3)}</span></div><div class="collapsible-content"><p>UE低于0.1元，处于危险区间，建议立即排查成本结构</p></div></div>`;
        } else if (ue < 0.5) {
          html += `<div class="collapsible"><div class="collapsible-header">⚠️ ${getCityDisplayName(city.displayName)} - UE预警 <span class="text-warning">${ue.toFixed(3)}</span></div><div class="collapsible-content"><p>UE低于0.5元，建议关注成本优化</p></div></div>`;
        }

        if (profitRate < 0.1) {
          html += `<div class="collapsible"><div class="collapsible-header">🚨 ${getCityDisplayName(city.displayName)} - 毛利率危险 <span class="text-danger">${(profitRate * 100).toFixed(1)}%</span></div><div class="collapsible-content"><p>毛利率低于10%，需要重点关注收入和成本结构</p></div></div>`;
        }
      });

      anomalyList.innerHTML = html || '<div class="empty-state"><div>✅ 暂无严重异常</div></div>';

      anomalyList.querySelectorAll('.collapsible-header').forEach(header => {
        header.addEventListener('click', () => header.parentElement.classList.toggle('collapsed'));
      });
    }

    /**
     * @description 切换城市排名项的展开/折叠状态
     * @param {HTMLElement} el - 被点击的city-rank-item元素
     */
    function toggleCityRankExpand(el) {
      const detail = el.querySelector('.city-rank-detail');
      if (!detail) return;
      const isExpanded = el.classList.contains('expanded');
      el.classList.toggle('expanded');
      detail.style.display = isExpanded ? 'none' : 'block';
    }

    function renderCityRankTable() {
      const cities = currentData.cities.map(city => ({
        city: city,
        ue: parseFloat(city.modules.all?.ue) || 0,
        profitRate: parseFloat(city.modules.all?.profitRate) || 0
      }));

      function getQuartiles(values) {
        const sorted = [...values].sort((a, b) => a - b);
        const q1 = sorted[Math.floor(sorted.length * 0.25)];
        const q2 = sorted[Math.floor(sorted.length * 0.5)];
        const q3 = sorted[Math.floor(sorted.length * 0.75)];
        return { q1, q2, q3, min: sorted[0], max: sorted[sorted.length - 1] };
      }

      const ueStats = getQuartiles(cities.map(c => c.ue));
      const profitStats = getQuartiles(cities.map(c => c.profitRate));

      const ueDangerThreshold = ueStats.q1 || 0.1;
      const ueWarningThreshold = ueStats.q3 || 0.5;
      const profitDangerThreshold = profitStats.q1 || 0.1;
      const profitWarningThreshold = profitStats.q3 || 0.2;

      const sortedCities = [...cities].sort((a, b) => b.ue - a.ue);

      // 移动端可展开行视图
      const isMobile = window.innerWidth <= 576;
      if (isMobile) {
        let mobileHtml = '<div class="city-rank-list">';
        sortedCities.forEach((item, idx) => {
          const city = item.city;
          const mod = city.modules?.all || {};
          const ue = item.ue;
          const profitRate = item.profitRate;

          const uePct = Math.min(Math.max(ue / 1.0 * 100, 0), 100);
          const ueColor = ue >= ueWarningThreshold ? 'var(--success)' : ue >= ueDangerThreshold ? 'var(--warning)' : 'var(--danger)';
          const healthIcon = (ue >= ueWarningThreshold && profitRate >= profitWarningThreshold) ? '✅' : (ue < ueDangerThreshold || profitRate < profitDangerThreshold) ? '🚨' : '⚠️';

          mobileHtml += '<div class="city-rank-item" onclick="toggleCityRankExpand(this)">';
          mobileHtml += '<div class="city-rank-summary">';
          mobileHtml += '<span class="rank-badge">' + (idx + 1) + '</span>';
          mobileHtml += '<span class="rank-city">' + getCityDisplayName(city?.displayName || '') + '</span>';
          mobileHtml += '<div class="rank-bars">';
          mobileHtml += '<div class="rank-bar-row"><span class="rank-bar-label">UE ' + ue.toFixed(2) + '</span><div class="rank-bar"><div class="rank-bar-fill" style="width:' + uePct + '%;background:' + ueColor + ';"></div></div></div>';
          const prPct = Math.min(Math.max(profitRate / 0.3 * 100, 0), 100);
          const prColor = profitRate >= profitWarningThreshold ? 'var(--success)' : profitRate >= profitDangerThreshold ? 'var(--warning)' : 'var(--danger)';
          mobileHtml += '<div class="rank-bar-row"><span class="rank-bar-label">利率 ' + formatPercent(profitRate) + '</span><div class="rank-bar"><div class="rank-bar-fill" style="width:' + prPct + '%;background:' + prColor + ';"></div></div></div>';
          mobileHtml += '</div>';
          mobileHtml += '<span class="rank-health">' + healthIcon + '</span>';
          mobileHtml += '<span class="rank-expand-icon">▸</span>';
          mobileHtml += '</div>';

          // 展开详情
          mobileHtml += '<div class="city-rank-detail" style="display:none;">';
          mobileHtml += '<div class="detail-grid">';
          const detailItems = [
            { label: '订单量', value: formatNumber(mod?.orders) },
            { label: '交易额', value: formatMoney(mod?.gmvAmount) },
            { label: '单均收入', value: (parseFloat(mod?.avgRevenuePerOrder) || 0).toFixed(2) },
            { label: '单均支出', value: (parseFloat(mod?.avgCostPerOrder) || 0).toFixed(2) },
            { label: 'UE', value: ue.toFixed(3) },
            { label: '毛利率', value: formatPercent(profitRate) },
            { label: '毛利总额', value: formatMoney(mod?.profit) }
          ];
          detailItems.forEach(d => {
            mobileHtml += '<div class="detail-item"><span class="detail-label">' + d.label + '</span><span class="detail-value">' + d.value + '</span></div>';
          });
          mobileHtml += '</div></div>';
          mobileHtml += '</div>';
        });

        // 动态阈值说明
        mobileHtml += '<div style="padding: 8px 12px; font-size: 11px; color: var(--text-secondary);">';
        mobileHtml += '<strong>动态阈值：</strong>UE危险<' + ueDangerThreshold.toFixed(3) + '，预警<' + ueWarningThreshold.toFixed(3) + '；毛利率危险<' + formatPercent(profitDangerThreshold) + '，预警<' + formatPercent(profitWarningThreshold);
        mobileHtml += '</div>';

        mobileHtml += '</div>';
        document.getElementById('cityRankTable').innerHTML = mobileHtml;
        return;
      }

      let html = '<table style="width:100%;border-collapse:collapse;"><thead><tr><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:center;">排名</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:left;">城市</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:right;">订单量</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:right;">交易额</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:right;">单均收入</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:right;">单均支出</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:right;">UE</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:right;">毛利率</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:right;">毛利总额</th><th style="padding:8px 12px;font-size:12px;font-weight:600;color:var(--text-secondary);background:var(--bg-header);text-align:center;">健康度</th></tr></thead><tbody>';

      sortedCities.forEach((item, idx) => {
        const city = item.city;
        const mod = city.modules.all || {};
        const ue = item.ue;
        const profitRate = item.profitRate;
        
        let healthStatus = '';
        let healthIcon = '✅';
        let healthClass = 'text-success';
        
        const ueIsDanger = ue < ueDangerThreshold;
        const profitIsDanger = profitRate < profitDangerThreshold;
        const ueIsWarning = ue < ueWarningThreshold;
        const profitIsWarning = profitRate < profitWarningThreshold;
        
        if (ueIsDanger || profitIsDanger) {
          healthStatus = '危险';
          healthIcon = '🚨';
          healthClass = 'text-danger';
        } else if (ueIsWarning || profitIsWarning) {
          healthStatus = '预警';
          healthIcon = '⚠️';
          healthClass = 'text-warning';
        } else {
          healthStatus = '健康';
        }

        const ueClass = ue >= ueWarningThreshold ? 'text-success' : ue >= ueDangerThreshold ? 'text-warning' : 'text-danger';
        const profitClass = profitRate >= profitWarningThreshold ? 'text-success' : profitRate >= profitDangerThreshold ? 'text-warning' : 'text-danger';

        html += '<tr>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:center;">' + (idx + 1) + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;font-weight:600;">' + getCityDisplayName(city.displayName) + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:right;font-variant-numeric:tabular-nums;">' + formatNumber(mod.orders) + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:right;font-variant-numeric:tabular-nums;">' + formatMoney(mod.gmvAmount) + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:right;font-variant-numeric:tabular-nums;">' + (mod.avgRevenuePerOrder ? mod.avgRevenuePerOrder.toFixed(2) : '-') + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:right;font-variant-numeric:tabular-nums;">' + (mod.avgCostPerOrder ? mod.avgCostPerOrder.toFixed(2) : '-') + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:right;font-variant-numeric:tabular-nums;" class="' + ueClass + '">' + ue.toFixed(3) + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:right;font-variant-numeric:tabular-nums;" class="' + profitClass + '">' + formatPercent(profitRate) + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:right;font-variant-numeric:tabular-nums;">' + formatMoney(mod.profit) + '</td>';
        html += '<td style="padding:6px 10px;font-size:12px;text-align:center;" class="' + healthClass + '">' + healthIcon + ' ' + healthStatus + '</td>';
        html += '</tr>';
      });

      html += '</tbody>';
      
      html += '<tfoot><tr><td colspan="10" style="padding: 12px; font-size: 11px; color: var(--text-secondary); background: var(--bg-header); border-top: 1px solid var(--border);">';
      html += '<strong>动态阈值说明：</strong> ';
      html += 'UE阈值：危险<' + ueDangerThreshold.toFixed(3) + '，预警<' + ueWarningThreshold.toFixed(3) + '，健康≥' + ueWarningThreshold.toFixed(3) + '；';
      html += '毛利率阈值：危险<' + formatPercent(profitDangerThreshold) + '，预警<' + formatPercent(profitWarningThreshold) + '，健康≥' + formatPercent(profitWarningThreshold);
      html += '</td></tr></tfoot></table>';

      document.getElementById('cityRankTable').innerHTML = html;
    }

    const _renderDimension = function renderDimension() {
      if (!currentData) return;

      document.getElementById('dimensionEmpty').classList.add('hidden');
      document.getElementById('dimensionData').classList.remove('hidden');

      const cityCheckboxes = document.getElementById('cityCheckboxes');
      let checkboxHtml = '<label class="checkbox-label checked"><input type="checkbox" value="总商" checked onchange="renderDimensionTable()"> 总商</label>';
      
      currentData.cities.slice(0, 3).forEach(city => {
        checkboxHtml += `<label class="checkbox-label checked"><input type="checkbox" value="${city.name}" checked onchange="renderDimensionTable()"> ${getCityDisplayName(city.displayName)}</label>`;
      });

      currentData.cities.slice(3).forEach(city => {
        checkboxHtml += `<label class="checkbox-label"><input type="checkbox" value="${city.name}" onchange="renderDimensionTable()"> ${getCityDisplayName(city.displayName)}</label>`;
      });

      cityCheckboxes.innerHTML = checkboxHtml;
      renderDimensionTable();
    }

    // 为每个业务模块定义不同的指标组
    const METRIC_GROUPS_BY_MODULE = {
      all: [ // 全品类 - 完整指标
        {
          name: '订单指标',
          metrics: [
            { key: 'orders', label: '订单量汇总', format: 'number' },
            { key: 'franchiseOrders', label: '加盟订单量', format: 'number' },
            { key: 'selfOrders', label: '自配订单量', format: 'number' },
            { key: 'enterpriseOrders', label: '企客订单量', format: 'number' }
          ]
        },
        {
          name: 'GMV指标',
          metrics: [
            { key: 'gmvAmount', label: '原价交易额汇总', format: 'money' },
            { key: 'franchiseGMV', label: '加盟原价交易额', format: 'money' },
            { key: 'selfGMV', label: '自配原价交易额', format: 'money' }
          ]
        },
        {
          name: '收入指标',
          metrics: [
            { key: 'onlineRevenue', label: '线上收入', format: 'money' },
            { key: 'commission', label: '抽佣金额汇总', format: 'money' },
            { key: 'franchiseCommission', label: '加盟抽佣金额', format: 'money' },
            { key: 'selfCommission', label: '自配抽佣金额', format: 'money' },
            { key: 'enterpriseCommission', label: '企客商家抽佣金额', format: 'money' },
            { key: 'deliveryFee', label: '配送费汇总', format: 'money' },
