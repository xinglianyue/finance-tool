{
  "name": "finance-tool",
  "version": "1.0.0",
  "description": "财务分析工具 - 支持Excel导入、多维度数据分析",
  "main": "index.html",
  "scripts": {
    "test": "node test/syntax-check.js && node test/unit-tests.js",
    "test:syntax": "node test/syntax-check.js",
    "test:unit": "node test/unit-tests.js",
    "test:all": "npm run test:syntax && npm run test:unit",
    "lint": "echo 'Linting not configured yet'",
    "build": "npm run test:all && echo 'Build successful!'",
    "deploy": "npm run build && git push origin main",
    "check": "node test/syntax-check.js index-new.html"
  },
  "keywords": ["finance", "analysis", "excel", "dashboard"],
  "author": "xinglianyue",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}